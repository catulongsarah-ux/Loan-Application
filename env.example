# ------------------------------------------------------------------
# Supabase connection (OPTIONAL)
# ------------------------------------------------------------------
# The app runs WITHOUT these using a built-in local (browser) fallback,
# so you can demo immediately. To use a shared cloud database instead:
#
#   1. Create a free project at https://supabase.com
#   2. Project Settings -> API -> copy the Project URL and the "anon public" key
#   3. Copy this file to ".env" and paste the values below
#   4. Run the SQL in supabase-schema.sql (Supabase -> SQL Editor)
#
# NOTE: Vite only exposes variables that start with VITE_ to the app.
# The "anon" key is safe to ship in a front-end app; do NOT use the
# "service_role" key here.
# ------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Passcode to open the /dashboard admin view (change this).
VITE_DASHBOARD_PASSCODE=letmein
